# Copy to .env and fill in. Never commit .env.

# Infra Postgres admin (same credentials as ChatMe / Hardliq on this VPS)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fitcore

# JWT — must be at least 32 characters
# openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRY_MINUTES=60

# Seeded once on API startup if this email is not already in PlatformAdmins
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=change-me

# Public URL of the FitCore SPA (exact browser origin for CORS)
# Must be a DIFFERENT hostname than Task Manager / ChatMe.
PUBLIC_ORIGIN=https://fit-core-crm.duckdns.org

# Optional SES (invite / email flows)
EMAIL_FROM=
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
